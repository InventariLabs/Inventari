# Inventari configuration.
#
# `make dev-up` generates a working development .env from this file when none
# exists: it fills in the secrets, points mail at Mailhog and sets DEBUG=true.
# You do not need to copy this file by hand to start — see README.md.
#
# Writing your own instead? Then this file is the field list, not a template to
# rename: generate SECRET_KEY, FERNET_SALT, ENCRYPTION_KEY and the database
# passwords (every change-me placeholder below is refused outside debug mode),
# and set DEBUG=true for development. For a real
# deployment start from .env.production.example and QUICK_DEPLOY.md.
#
# Under Docker, some values here are built by Compose or are not forwarded
# to the backend and have no effect — each is marked below. They matter when
# the backend runs from a checkout instead of a container: a process started
# in `backend/` reads this file's values out of the root `.env`.

# Database (Application)
DB_NAME=inventari_db
DB_USER=inventari_user
DB_PASSWORD=change-me-strong-password
# Ignored under Docker: compose builds this from DB_USER/DB_PASSWORD/DB_NAME
# against the `db` service.
DATABASE_URL=postgresql://inventari_user:change-me-strong-password@localhost:5432/inventari_db

# Where migrations and the db CLI commands connect instead: straight at
# Postgres, never through a transaction-mode pooler, which would hand the
# migration advisory lock and its unlock to different server connections. The
# application keeps using DATABASE_URL. Empty, it is DATABASE_URL.
# Ignored under Docker: docker-compose.prod.yml builds it for the container out
# of the credentials DATABASE_URL carries.
# MIGRATION_DATABASE_URL=

# Transaction retry for serialization conflicts and deadlocks (SQLSTATE
# 40001/40P01, app/core/db_retry.py): the attempts a request makes before the
# client gets the database's own error (1 = no retry), the backoff and jitter
# in milliseconds that keep two collided requests from meeting again on the
# same beat, and the body size in bytes above which a request keeps today's
# behaviour instead of being buffered for a replay (262144 = 256 KiB).
# Ignored under Docker: no compose file forwards them, so the containers run
# on the defaults shown and a host run is where they are read from .env.
DB_RETRY_MAX_ATTEMPTS=3
DB_RETRY_BACKOFF_MS=10
DB_RETRY_JITTER_MS=20
DB_RETRY_MAX_BODY_BYTES=262144

# Database (Products - OFF)
PRODUCTS_DB_NAME=products_db
PRODUCTS_DB_USER=products_user
PRODUCTS_DB_PASSWORD=change-me-strong-password
# Left unset on purpose. docker-compose.yml passes this value into the backend
# container verbatim, where `localhost` is the container itself, and the products
# database only exists behind the `food` profile. Set it when you enable that
# profile, with the compose service name as the host (running the backend
# directly on the host, use localhost instead):
# PRODUCTS_DATABASE_URL=postgresql://products_user:change-me-strong-password@products-db:5432/products_db

# Redis
# Ignored under Docker: compose points the backend at the `redis` service.
REDIS_URL=redis://localhost:6379

# Optional second instance with a noeviction policy, for the keys that must not
# be evicted under memory pressure: the token blacklist and the rate limiter.
# Unset, REDIS_URL serves them too — right for a single instance.
# docker-compose.prod.yml points it at the `redis-critical` service and does not
# take the value from this file; the development stack has no second instance
# and forwards the name nowhere.
# REDIS_CRITICAL_URL=

# The two streams events and background tasks are written into: their names, how
# large each may grow (MAXLEN caps growth on every append), and how long an
# entry may sit unclaimed before the periodic reaper takes it (XAUTOCLAIM).
# Ignored under Docker: no compose file forwards them.
REDIS_STREAM_NAME=inventari_stream
REDIS_TASKS_STREAM_NAME=inventari_tasks
EVENT_STREAM_MAXLEN=100000
TASK_STREAM_MAXLEN=10000
STREAM_CLAIM_IDLE_MS=60000

# JWT Secret — generate with: openssl rand -hex 32
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32

# How long a refresh token lives, in days: the session is renewed with it for as
# long as it keeps being used, while the access token itself lives
# ACCESS_TOKEN_EXPIRE_MINUTES minutes (backend/.env.example).
# Ignored under Docker: no compose file forwards it.
REFRESH_TOKEN_EXPIRE_DAYS=30

# Per-deployment Fernet salt — encrypts org secrets (LLM/SMTP/Jina keys).
# Generate with: openssl rand -hex 32
# The placeholder below is refused outside DEBUG/TESTING: a salt shared with
# every other deployment protects nothing.
# Never change it once the first secret is saved: it salts every encryption
# key, nothing can rotate it, and a changed salt leaves every stored secret
# unreadable for good.
FERNET_SALT=change-me-generate-with-openssl-rand-hex-32

# The key org secrets are encrypted with. Set it on the first install: left
# empty, SECRET_KEY is used, and rotating SECRET_KEY then means re-encrypting
# every stored secret. With its own key the signing key rotates freely.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=
# Only during a rotation: the key ENCRYPTION_KEY replaced, read until
# `python manage.py secrets reencrypt --apply` has rewritten every secret
# (DEPLOYMENT.md, "Rotating the encryption key").
PREVIOUS_ENCRYPTION_KEY=

# Which hops gunicorn trusts X-Forwarded-For from. '*' is right while the
# backend port is only reachable from the reverse proxy; name the proxy's
# address if you publish 8000. Getting it wrong is quiet: every request
# buckets to the proxy, so one client's brute force spends everyone's limit.
# Ignored on the development stack, whose uvicorn command never reads it;
# docker-compose.prod.yml passes it to gunicorn.
FORWARDED_ALLOW_IPS=*

# What the backend and the database may use on this host (optional; the
# values below are what the compose file ships). DEPLOYMENT.md, "Sizing the
# services to the host", says what to set for 4, 8 and 16 GB.
#BACKEND_MEM_LIMIT=2g
#WEB_CONCURRENCY=4
# PgBouncer's client limit: keep it above WEB_CONCURRENCY x 50.
#PGBOUNCER_MAX_CLIENT_CONN=300
#DB_MEM_LIMIT=2g
#DB_SHARED_BUFFERS=512MB
#DB_EFFECTIVE_CACHE_SIZE=2GB
# A worker is replaced once it has grown this far past its start-up size, and
# when it has sat idle this long a quarter over it (0 turns the idle rule off).
#BACKEND_WORKER_MAX_GROWTH_MB=200
#BACKEND_WORKER_IDLE_RECYCLE_SECONDS=120

# The model an organization gets when it has bound none in Settings -> AI
# Connections (optional). LLM_PROVIDER is one of the providers that screen
# offers (openrouter, openai, deepseek, mimo, groq, mistral, ...); LLM_API_KEY
# is its key. LLM_API_BASE_URL is that provider's endpoint. LLM_CAPABILITIES
# is what the model can do — text, vision — and a purpose it does not name
# (reading a photograph, say) is refused up front instead of failing at the
# provider; empty means text,vision for openrouter and text for any other
# provider. A wrong provider, or another provider's key left on the
# OpenRouter address, stops the backend at start-up with the variable named.
#
#   OpenRouter:  LLM_PROVIDER=openrouter
#                LLM_API_BASE_URL=https://openrouter.ai/api/v1
#                LLM_MODEL=google/gemini-2.0-flash-001
#   DeepSeek:    LLM_PROVIDER=deepseek
#                LLM_API_BASE_URL=https://api.deepseek.com
#                LLM_MODEL=deepseek-flash
#                LLM_CAPABILITIES=text
#   MiMo:        LLM_PROVIDER=mimo
#                LLM_API_BASE_URL=https://api.xiaomimimo.com/v1
#                LLM_MODEL=mimo-v2.6-flash
#                LLM_CAPABILITIES=text
#
# Add vision only for a model that passed the vision probe of the connection
# test (Settings -> AI Connections -> Test, same provider, key and model).
#
# On a public instance set a spending cap at the provider as well: a funded
# key here serves every organization that has bound nothing.
LLM_API_KEY=
# The earlier name of LLM_API_KEY, still read when that one is empty.
#OPENROUTER_API_KEY=
LLM_PROVIDER=openrouter
LLM_API_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=
LLM_CAPABILITIES=

# Outbound email (SMTP)
# Empty SMTP_HOST means the app sends no mail at all — password resets and
# invitations will not arrive. Point it at your own server to enable them.
# Encryption is read off the port: 587 is STARTTLS, 465 is implicit TLS,
# anything else is plaintext. Set host and port together.
# `make dev-up` writes the local Mailhog pair (mailhog / 1025) into a freshly
# generated .env instead, so dev mail stays on the machine.
# Per-organization SMTP configured in the app's settings wins over both.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=noreply@inventari.app
EMAILS_FROM_NAME=Inventari
# Which way to encrypt, decided here instead of by the port: 'none', 'starttls'
# or 'ssl'. Left unset the port votes as it always did — 587 STARTTLS, 465
# implicit TLS, anything else plaintext — so an installation that never set
# this keeps working; set it to stop the port voting.
# Ignored under Docker: docker-compose.demo.yml pins 'none' for the mail
# catcher beside that stack, and no other compose file forwards the name, so a
# host run is where it applies.
# SMTP_ENCRYPTION=

# File Storage Configuration
# Backend: 'local' | 's3' (S3, R2, OVH Object Storage)
FILE_STORAGE_BACKEND=local

# Local storage (when FILE_STORAGE_BACKEND=local)
FILE_STORAGE_LOCAL_PATH=/app/uploads

# S3-compatible storage (when FILE_STORAGE_BACKEND=s3)
# Works with: AWS S3, Cloudflare R2, OVH Object Storage
FILE_STORAGE_S3_BUCKET=
FILE_STORAGE_S3_ACCESS_KEY=
FILE_STORAGE_S3_SECRET_KEY=
FILE_STORAGE_S3_REGION=us-east-1
# Custom endpoint (for R2 or OVH; leave empty for AWS S3)
FILE_STORAGE_S3_ENDPOINT_URL=

# How large a request body may be before the backend refuses it — a hard ceiling
# in bytes, counted above the per-endpoint limits (attachments 10 MB, equipment
# 20 MB, imports 50 MB, vision images 10 MB). 53477376 is 51 MB: a 50 MB payload
# plus multipart overhead. It exists so a backend running without the reverse
# proxy, which caps bodies in the Caddyfile, is not a free memory sink.
# Ignored under Docker: no compose file forwards it — the containers sit behind
# Caddy and keep the per-endpoint limits.
MAX_REQUEST_BODY_SIZE=53477376

# Reaching a machine on your own network
# The server refuses to call an address that is not routable on the public
# internet — a webhook pointed at Home Assistant on 192.168.x.x, or an AI
# connection pointed at Ollama on the same box. Turn these on and it will.
#
# What it costs: whoever types the URL decides where this server connects, so
# on an install serving only you it is a convenience, and on one serving
# several organizations it lets an organization admin aim your server at your
# internal network. Leave them false there.
#
# The two are separate on purpose — allowing a local model server is not the
# same decision as allowing outbound webhooks to your LAN.
WEBHOOKS_ALLOW_PRIVATE_NETWORKS=false
LLM_ALLOW_PRIVATE_NETWORKS=false

# How long one model call may wait for an answer, in seconds. The second one
# applies to the local runtimes (ollama, lm_studio, vllm) and is far higher on
# purpose: a model on your own graphics card is measured in minutes — a 8B
# vision model with an 8192-token window took 60.1 s for a single photograph
# on an RX 6800 — while a cloud endpoint silent for a minute is not going to
# answer. See docs/subsystems/LLM.md.
# Ignored under Docker: no compose file forwards them — a host run only.
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_LOCAL_REQUEST_TIMEOUT_SECONDS=300

# CORS — where the links in invitations, registrations and password resets
# point, so every mail that carries one is built from the address people
# actually use.
# Ignored under Docker: both stacks build it themselves (http://localhost:5173
# on the development stack, the DOMAIN of the production one).
FRONTEND_URL=http://localhost:5173

# Logging
# Ignored under Docker: no compose file forwards them, so the containers log
# where the code sends it and a host run is where these apply.
LOG_LEVEL=INFO
LOG_DIR=/app/logs
SQL_ECHO=false

# Default language — what an account created without a language of its own
# starts in (`manage.py user create-admin` without `--lang`), and what the
# server answers in when a request names no language it speaks: `en`, `de`,
# `es`, `fr` or `pl`. Every user picks their own language in Settings
# afterwards.
DEFAULT_LANGUAGE=en

# Rate limiting — slowapi limits syntax, the backstop on every request bucket
# (API key > JWT user > client IP, app/core/limiter.py); an endpoint that needs
# a tighter or looser value carries its own. LOGIN is the sign-in brute-force
# guard, REFRESH guards /auth/refresh, which every SPA boot calls.
# Commented out on purpose: the development stack raises all three itself
# (docker-compose.yml) so a test fleet does not stall on 429s, and the
# production stack runs on the defaults shown here. Uncomment them where the
# stack that runs the backend reads its .env — a host run reads them from this
# file.
# RATE_LIMIT_PER_IP=200 per minute
# RATE_LIMIT_LOGIN=5 per minute
# RATE_LIMIT_REFRESH=20 per minute

# Which install this is, for the commands that destroy data (`db reset`,
# `db downgrade`, `demo reset`): they ask for a positive answer — DEBUG or
# TESTING on, or one of these names — instead of reading the absence of
# "production" as permission. `development` and `staging` are the names the
# guard allows (app/cli/__init__.py).
# ENVIRONMENT= is the same switch under a generic, older name: an alias, kept
# for a stack that already carries it. Set both and INVENTARI_ENV answers.
# INVENTARI_ENV=
# ENVIRONMENT=
#
# Compose answers these two itself rather than from this file:
#   INVENTARI_DEPLOYMENT=production   — docker-compose.prod.yml, so the CLI
#       prints the next step for the stack you are on, not the development one
#   INVENTARI_FRONTEND_MODULES_DIR=/frontend-modules — both stacks, the mount
#       where the frontend half of a community module lands
# A host run needs neither. INVENTARI_PROJECT_ROOT is the override for the
# checkout itself, for a layout where walking up from the CLI's own file does
# not find `backend/` and `frontend/` beside each other.
# INVENTARI_PROJECT_ROOT=

# Startup, and the account it bootstraps — read only by a backend run outside
# the compose stacks, which forward neither.
# Refuse to start rather than serve with a module that failed to initialize:
# off, the module's screens are simply missing and the error is in the log; on,
# the backend stays down until it is fixed (app/_lifespan.py).
STRICT_STARTUP=false
# The user promoted to superuser when the installation bootstraps one
# (app/services/bootstrap_service.py). Empty, the first user created is
# promoted instead.
# SUPERUSER_EMAIL=

# The public demo (docs/DEMO.md) — what a demo lets its visitors cost the
# instance. docker-compose.demo.yml is the only stack that reads them, and it
# carries these same values as its defaults; a normal installation has the
# per-endpoint limits and its own settings instead, and never reads any of it.
INVENTARI_DEMO=false
DEMO_INBOX_URL=
DEMO_UPLOAD_FILE_MB=2
DEMO_UPLOAD_TOTAL_MB=200
DEMO_SANDBOX_POOL_SIZE=3
DEMO_SANDBOX_DAILY_CAP=100
DEMO_SANDBOX_RATE_LIMIT=10/hour
DEMO_AI_REQUESTS_MONTHLY=20
# The inbox the demo's mail is caught in, so the sign-in screen can say where to
# look. The stack points it at the Mailpit beside itself; set it only when that
# inbox is somewhere else.
# DEMO_INBOX_API_URL=

# Debug mode (never true in production).
# `make dev-up` sets this to true in the .env it generates; this file keeps the
# safe value so that copying it somewhere real cannot quietly turn off the
# startup checks on SECRET_KEY and FERNET_SALT.
DEBUG=false

# Postgres tuning (docker-compose.yml dev DB). Optional — defaults are conservative
# so postgres starts on modest hardware. Raise on a beefy dev box if needed.
# POSTGRES_SHARED_BUFFERS=256MB
# POSTGRES_EFFECTIVE_CACHE_SIZE=1GB
# POSTGRES_MAINTENANCE_WORK_MEM=256MB
# POSTGRES_WORK_MEM=16MB

# Keys of community-module publishers this deployment trusts, comma- or
# newline-separated, each as key_id=<base64 Ed25519 public key>. Empty means
# nothing is trusted: signed installs refuse, unsigned installs need
# `module install --allow-unsigned`.
# MODULE_SIGNING_PUBLIC_KEYS=my-releases=<base64 public key>

# ─── Test-only switches ─────────────────────────────────────────────────────
# Never on where people use the installation: each one either turns off a
# protection or hands a test a hook, and none of them says so on any screen.
# They are listed because the development stack reads them out of .env
# (docker-compose.yml), so a suite can reach a state it has to reach on purpose
# instead of waiting for one — which is what they are for, and why every line
# stays commented out: false is the default of each.
# config.py says what each refuses when it is on outside DEBUG/TESTING: TESTING
# opens the password-reset dev-token response, lets the token blacklist fail
# open and accepts a known-weak SECRET_KEY, so it carries TESTING_ACK_UNSAFE;
# LOAD_TESTING switches the global rate limiter off, so it carries
# LOAD_TESTING_ACK_UNSAFE.
# INVENTARI_VALIDATION_CACHE_DIR= is where the module-safety scan keeps its
# results between runs, so a test can put them somewhere of its own.
# TESTING=false
# TESTING_ACK_UNSAFE=false
# QA_FAULT_INJECTION=false
# LOAD_TESTING=false
# LOAD_TESTING_ACK_UNSAFE=false
# INVENTARI_VALIDATION_CACHE_DIR=
