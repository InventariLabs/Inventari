# Database
DATABASE_URL=postgresql://inventari_user:CHANGE_ME_strong_password@localhost:5432/inventari_db

# Redis
REDIS_URL=redis://localhost:6379

# JWT — generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Per-deployment Fernet salt — encrypts org secrets (LLM/SMTP/Jina keys).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
FERNET_SALT=CHANGE_ME_generate_with_secrets_token_urlsafe_32

# Key of the AI provider chosen by LLM_PROVIDER (optional, for Vision LLM)
LLM_API_KEY=

# CORS
FRONTEND_URL=http://localhost:5173
