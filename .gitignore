# Environment variables
.env
.env.local
.env.*.local

# rclone credentials for the offsite backup profile (see DEPLOYMENT.md)
rclone.conf

# Secrets / keys / certificates (never commit — defense-in-depth even if .env is covered above)
*.key
*.pem
*.crt
*.cer
*.p12
*.kdbx
backup-key*.txt
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
# Python build artifacts (lib/ and lib64/ at root level only)
/lib/
/lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# uv / Virtual environments
.venv/
venv/
ENV/
env/
# uv.lock is intentionally committed — required for reproducible CI builds
# uv.lock

# Pytest
.pytest_cache/
# Suite timing reports (make test-profile). A measurement of one machine at
# one moment, not source — and the load it carries is what makes it readable,
# so a report from another host is worse than no report.
backend/.pytest-profile/
.coverage
.coverage.*
htmlcov/
*.cover
.hypothesis/

# Coverage reports
frontend/coverage/
backend/htmlcov/
backend/.drift-observations/
# Written by `make test-coverage` (--cov-report=json) and read by
# backend/scripts/check_diff_coverage.py.
backend/coverage.json

# Alembic
*.db
*.sqlite
*.sqlite3

# Node / Frontend
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dist/
dist-ssr/
*.local

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Docker
*.log

# Uploads
backend/uploads/*
!backend/uploads/.gitkeep

# Deployment state: which community modules this installation has.
# Written by `manage.py module install`, so tracking it made every install
# show up as a modified file and collide on `git pull`.
backend/data/

# Where `make new-community-module` puts a package you are writing. Yours, not
# ours: bind-mounted so the backend container can install it for testing, and
# ignored so `git add -A` in this repository cannot swallow somebody's module.
modules-workspace/*
!modules-workspace/.gitkeep
# The pre-move location, still read once so an older installation keeps its list.
backend/community_modules.json

# Backups
backups/

# Temporary files
*.tmp
*.bak
*.swp
*~

# Version markers written by deploys before 0.11.0; nothing writes or reads them now
.version
backend/.version
frontend/.version

# OS
.DS_Store
Thumbs.db
screens/
load_tests/users.csv
.worktrees/

# Test artifacts
frontend/test-results/
frontend/playwright-report/
# Root-level test-run artifacts (e.g. .last-run.json written from the repo root)
/test-results/
frontend/tsconfig.tsbuildinfo

# Local assistant / editor tooling (personal, not for the repo)
CLAUDE.md
GEMINI.md
.agents/
.claude/skills/
.claude/settings.local.json
.opencode/
.gemini/
.gemini.json
skills-lock.json

# Test run outputs
tests_output.txt
frontend/test_output.txt
result.txt
single_run.txt
vitest_*.txt
heap.log

# Graph analysis output
graphify-out/

# Browser-automation session artifacts (screenshots, page snapshots)
.playwright-mcp/

# Playwright auth artifacts — these hold a live refresh_token cookie
storageState.json

# Screenshot dumps from manual QA sessions — one directory per session, named
# after the module and date.
qa-*/

# Module-safety scan cache — lands here when the container temp dir resolves
# inside the source tree (app/core/module_safety_analysis.py).
inventari-module-validation/

# Per-worktree stack wrappers: each one pins COMPOSE_PROJECT_NAME to one stack
# number and belongs to the single checkout that holds that number. Committed,
# it would travel to every other checkout and point `docker compose` at a stack
# mounting somebody else's source. dev2 is the exception: `make
# test-e2e-isolated` provisions it by name and AGENTS.md sends every E2E run
# there.
/scripts/dev[0-9]*
!/scripts/dev2
/docker-compose.dev[0-9]*.yml
!/docker-compose.dev2.yml

# The maintainers' private word lists for the internal-id gate (backend/scripts/check_internal_ids.py).
backend/scripts/internal_id_prefixes.local
backend/scripts/internal_private_words.local
mutants/
