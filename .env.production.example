# ─────────────────────────────────────────────────────
# Inventari — Production Environment
# ─────────────────────────────────────────────────────

# Your domain (e.g. inventari.example.com)
DOMAIN=

# Optional: the www name (www.<domain>). Set it only when it has a DNS record;
# Caddy then gets a certificate for it and redirects it to DOMAIN.
WWW_DOMAIN=

# Optional: a demo instance (docs/DEMO.md) on this same server. Set it to the
# demo's name (demo.<domain>) once it has a DNS record; this stack's Caddy then
# gets the certificate and forwards to the demo stack. Leave empty otherwise.
DEMO_DOMAIN=

# Email for Let's Encrypt SSL certificate notifications
ACME_EMAIL=

# ─── Main Database ────────────────────────────────────
# Two roles. DB_USER is the administrator the postgres image creates — a
# superuser, used only to set the database up, back it up and restore it.
# DB_APP_USER is what the application connects as: owner of the schema, no
# superuser rights, so a bug in the application cannot reach the server's
# files or run programs on it. Both passwords are required and must be hex.
DB_NAME=inventari_db
DB_USER=inventari_user
DB_PASSWORD=
DB_APP_USER=inventari_app
DB_APP_PASSWORD=

# ─── Products Database (Open Food Facts) ─────────────
# Optional — used only with the `food` compose profile (the nutrition module's
# offline barcode lookup). Enabling the profile also needs PRODUCTS_DATABASE_URL
# below; see DEPLOYMENT.md, "Optional: the Open Food Facts database", and
# docs/OFF_DATABASE_SETUP.md for the dataset import.
#
# Two roles, the same split as the main database: PRODUCTS_DB_USER is the
# administrator the image creates (a superuser, kept for setup and imports) and
# PRODUCTS_DB_APP_USER is what PRODUCTS_DATABASE_URL should connect as — owner
# of the schema, no superuser rights. The profile's `products-app-role`
# one-shot creates that role on the first start and refuses to run without
# PRODUCTS_DB_APP_PASSWORD.
PRODUCTS_DB_NAME=products_db
PRODUCTS_DB_USER=products_user
PRODUCTS_DB_PASSWORD=
PRODUCTS_DB_APP_USER=products_app
PRODUCTS_DB_APP_PASSWORD=
# postgresql://products_app:<PRODUCTS_DB_APP_PASSWORD>@products-db:5432/products_db
PRODUCTS_DATABASE_URL=

# ─── Redis ───────────────────────────────────────────
# Guards the JWT blacklist and rate-limit counters. Required — the stack
# refuses to start without it.
# The value is interpolated into REDIS_URL verbatim, so it must contain only
# URL-safe characters. A hex string qualifies; @ : / ? # % do not, and would
# corrupt the connection URL rather than fail loudly.
# Generate with: openssl rand -hex 32
REDIS_PASSWORD=

# ─── Application ─────────────────────────────────────
# Signs login tokens. Generate with: openssl rand -hex 32
SECRET_KEY=

# Encrypts what organizations store as secrets (mail passwords, AI provider
# keys, webhook secrets). Set it on the first install, to a value of its own:
# left empty, SECRET_KEY does this job too, and rotating SECRET_KEY after a
# token leak then means re-encrypting every stored secret
# (DEPLOYMENT.md, "Rotating the encryption key").
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=
# Only during a rotation: the key ENCRYPTION_KEY replaced, still read until
# `manage.py secrets reencrypt --apply` has run. Empty otherwise.
PREVIOUS_ENCRYPTION_KEY=

# Per-deployment Fernet salt — encrypts org secrets (LLM/SMTP/Jina keys).
# REQUIRED in production (>=16 bytes). Different value per deployment!
# Generate with: openssl rand -hex 32
# The example values shipped in `.env.example` are refused outside
# DEBUG/TESTING — copying one over would clear the length check while leaving
# every deployment on the same salt.
# NEVER change it once the first secret is saved: it salts every encryption
# key derived here, there is no rotation for it, and a changed salt leaves
# every stored secret unreadable for good. Keep it with the copy of .env.
FERNET_SALT=

# The model an organization gets when it has bound none in Settings -> AI
# Connections (optional). LLM_PROVIDER is one of the providers that screen
# offers (openrouter, openai, deepseek, mimo, groq, mistral, ...); LLM_API_KEY
# is its key. LLM_API_BASE_URL is that provider's endpoint. LLM_CAPABILITIES
# is what the model can do — text, vision — and a purpose it does not name
# (reading a photograph, say) is refused up front instead of failing at the
# provider; empty means text,vision for openrouter and text for any other
# provider. A wrong provider, or another provider's key left on the
# OpenRouter address, stops the backend at start-up with the variable named.
#
#   OpenRouter:  LLM_PROVIDER=openrouter
#                LLM_API_BASE_URL=https://openrouter.ai/api/v1
#                LLM_MODEL=google/gemini-2.0-flash-001
#   DeepSeek:    LLM_PROVIDER=deepseek
#                LLM_API_BASE_URL=https://api.deepseek.com
#                LLM_MODEL=deepseek-flash
#                LLM_CAPABILITIES=text
#   MiMo:        LLM_PROVIDER=mimo
#                LLM_API_BASE_URL=https://api.xiaomimimo.com/v1
#                LLM_MODEL=mimo-v2.6-flash
#                LLM_CAPABILITIES=text
#
# Add vision only for a model that passed the vision probe of the connection
# test (Settings -> AI Connections -> Test, same provider, key and model).
#
# On a public instance set a spending cap at the provider as well: a funded
# key here serves every organization that has bound nothing.
LLM_API_KEY=
LLM_PROVIDER=openrouter
LLM_API_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=google/gemini-2.0-flash-001
LLM_CAPABILITIES=

# How long one model call may wait for an answer, in seconds; the second
# applies to local runtimes (ollama, lm_studio, vllm). See docs/subsystems/LLM.md.
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_LOCAL_REQUEST_TIMEOUT_SECONDS=300

# Where uploaded files live: 'local' (the uploads volume) or 's3' (AWS S3,
# Cloudflare R2, OVH Object Storage). Required before running a second backend
# replica — see docs/SCALING.md. The S3 settings apply only with 's3'.
FILE_STORAGE_BACKEND=local
FILE_STORAGE_S3_BUCKET=
FILE_STORAGE_S3_ACCESS_KEY=
FILE_STORAGE_S3_SECRET_KEY=
FILE_STORAGE_S3_REGION=us-east-1
# Custom endpoint for R2 or OVH; leave empty for AWS S3.
FILE_STORAGE_S3_ENDPOINT_URL=

# Debug mode has no entry here: docker-compose.prod.yml sets DEBUG=false for
# the backend itself, and a switch that turns on QA fault injection and the
# rest of the debug surface does not belong in a file an operator edits —
# following this example must not be able to switch it on. Only a backend run
# directly on the host, which is not how this stack runs, reads it from .env.

# ─── Community modules ───────────────────────────────
# Keys of community-module publishers this deployment trusts, comma- or
# newline-separated, each as key_id=<base64 Ed25519 public key>. A signed
# package installs only when its signing key is listed here; empty means
# nothing is trusted, and every signed install is refused. The publisher's
# install instructions print the entry to add (their `module sign --key-id`
# names it), and the installer's refusal repeats it when the list is empty.
MODULE_SIGNING_PUBLIC_KEYS=

# ─── Database backups ────────────────────────────────
# Optional. Public half of an age key pair: with it the daily PostgreSQL dump
# is encrypted before it is written, so ./backups only ever holds ciphertext.
# Empty is fine — the stack starts and backs up to plain files only root can
# read, with a warning in the log; the off-host copy needs a key. To encrypt
# run `make backup-key`: it prints the private key ONCE and saves it nowhere —
# keep it off this server, because without it the backups cannot be read by
# anyone. Then prove it works with `make backup-verify`. See DEPLOYMENT.md →
# "Database Backups".
AGE_RECIPIENT=

# Optional off-host copy: an rclone destination the encrypted dumps are
# synced to (e.g. gdrive:Inventari/prod-backups). Needs an rclone.conf next
# to this file and the `offsite` compose profile; see DEPLOYMENT.md.
BACKUP_RCLONE_REMOTE=

# Where your users can get the source of the version you run — shown on the
# About screen. Leave empty for the upstream repository; if you run a modified
# version, AGPL-3.0 §13 requires you to point this at your own source.
SOURCE_CODE_URL=

# Who runs this instance and how people reach you about their data — shown on
# the public privacy page (/privacy), where visitors are told to ask you for a
# copy of their data or its deletion. A name (a person or a company) and an
# email address or a URL. Left empty, the page says the operator has not
# published a contact.
OPERATOR_NAME=
OPERATOR_CONTACT=

# Default language — what an account created without a language of its own
# starts in (`manage.py user create-admin` without `--lang`), and what the
# server answers in when a request names no language it speaks: `en`, `de`,
# `es`, `fr` or `pl`. Every user picks their own language in Settings
# afterwards.
DEFAULT_LANGUAGE=en
