# ============================================================
# Inventari Print Agent — Configuration
# Copy this file to .env and fill in your values
# ============================================================

# --- Required ---
INVENTARI_URL=https://your-inventari-instance.example.com
# Issue it in Settings → API Keys with "Printing only": it can do nothing else.
INVENTARI_API_KEY=your-api-key-from-inventari-settings

# --- This printer's name in the app (serve mode; default: the host name) ---
# AGENT_NAME=office
# QUEUE_INTERVAL=3    # seconds between asks for work
# SEPARATE_LABELS=true  # brother-p710bt: a job's labels come out cut apart; false = one strip

# --- Printer type ---
# Options: brother-p710bt | cups | command
PRINTER_TYPE=brother-p710bt

# CUPS: name of the printer (lpr -P <name>). Leave blank to use system default.
# PRINTER_NAME=office-label-printer

# Custom shell command. Use {file} as placeholder for the PNG path.
# PRINTER_COMMAND=lp -d my-printer {file}

# --- Fitting the label to this printer (see README, "Your printer") ---
# The label's size is chosen in the app; these say what this printer can do.
# PRINTER_DPI=203             # draw the label at the printer's resolution
#                             # (a Brother: 180 unless set; others: the file's 300)
# PRINTER_MAX_HEIGHT_PX=384   # dots the head prints across; a taller label is
#                             # scaled down (a Brother reads it from its tape)

# --- Blank-label pool labels (run and print-now modes only) ---
LABEL_WIDTH=50        # mm
LABEL_HEIGHT=24       # mm
LABEL_BATCH_SIZE=50   # max labels per poll cycle
# LABEL_COLUMNS=10    # labels per row (default: all in one strip)
# LABEL_QR_ONLY=false # set to true to skip text, print QR only

# --- Blank-label pool (run mode) ---
POLL_INTERVAL=30      # seconds between checks
