{
  "name": "inventari-frontend",
  "private": true,
  "license": "AGPL-3.0-only",
  "version": "0.11.0",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "build:check": "tsc && vite build && node scripts/check-bundle-budget.mjs",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "lint:i18n": "node scripts/lint-i18n-raw.mjs",
    "lint:tests": "node scripts/lint-test-assertions.mjs",
    "lint:ui": "node scripts/lint-ui-conventions.mjs",
    "scan:ui": "node scripts/scan-ui-patterns.mjs",
    "check:i18n": "node scripts/check-i18n-keys.mjs --baseline",
    "check:en-spelling": "node scripts/check-en-spelling.mjs",
    "check:vocabulary": "node scripts/check-vocabulary.mjs --baseline",
    "check:title-case": "node scripts/check-title-case.mjs --baseline",
    "check:title-case:baseline": "node scripts/check-title-case.mjs --write-baseline",
    "check:vocabulary:baseline": "node scripts/check-vocabulary.mjs --write-baseline",
    "check:i18n:unused": "node scripts/check-i18n-keys.mjs --unused --baseline",
    "check:audit-fields": "node scripts/check-audit-fields.mjs --baseline",
    "check:audit-fields:fresh": "node scripts/check-audit-fields.mjs --freshness --baseline",
    "check:i18n:plural-report": "node scripts/check-i18n-keys.mjs --plural-report",
    "check:i18n:plural-snapshot": "node scripts/check-i18n-keys.mjs --write-plural-snapshot",
    "check:routes": "node scripts/check-route-reachability.mjs --baseline",
    "check:focus-reachability": "node scripts/check-focus-reachability.mjs --baseline",
    "check:reachable": "node scripts/check-reachability.mjs --baseline",
    "check:boundaries": "node scripts/check-module-boundaries.mjs --baseline",
    "perf:phone": "node scripts/measure-phone-budget.mjs",
    "check:public-bundle": "node scripts/check-public-bundle.mjs",
    "check:dialogs": "node scripts/check-dialog-names.mjs --quiet",
    "check:field-names": "node scripts/check-field-names.mjs --baseline",
    "check:field-names:baseline": "node scripts/check-field-names.mjs --write-baseline",
    "check:storage-scope": "node scripts/check-storage-scope.mjs --baseline",
    "check:storage-scope:baseline": "node scripts/check-storage-scope.mjs --write-baseline",
    "check:category-scope": "node scripts/check-category-scope.mjs --baseline",
    "check:query-error-read": "node scripts/check-query-error-read.mjs --baseline",
    "check:query-error-read:baseline": "node scripts/check-query-error-read.mjs --write-baseline",
    "check:mutate-async": "node scripts/check-mutate-async-handled.mjs --baseline",
    "check:mutate-async:baseline": "node scripts/check-mutate-async-handled.mjs --write-baseline",
    "check:category-scope:baseline": "node scripts/check-category-scope.mjs --write-baseline",
    "check:quantity-render": "node scripts/check-quantity-render.mjs --baseline",
    "check:quantity-render:baseline": "node scripts/check-quantity-render.mjs --write-baseline",
    "check:quantity-bounds": "node scripts/check-quantity-bounds.mjs --quiet",
    "check:type-scale": "node scripts/check-type-scale.mjs --quiet",
    "check:empty-state": "node scripts/check-empty-state.mjs --quiet",
    "check:theme-colors": "node scripts/check-theme-colors.mjs --quiet",
    "check:primary-tabs": "node scripts/check-primary-tabs.mjs --quiet",
    "check:e2e-waits": "node scripts/check-e2e-wait-for-timeout.mjs",
    "check:e2e-waits:baseline": "node scripts/check-e2e-wait-for-timeout.mjs --write-baseline",
    "check:plurals": "node scripts/check-plural-counts.mjs --quiet",
    "check:consumers": "node scripts/check-endpoint-consumers.mjs",
    "check:invalidation": "node scripts/check-invalidation-keys.mjs --quiet",
    "check:onerror": "node scripts/check-on-error-refusals.mjs --quiet",
    "check:mirrors": "node scripts/check-mirrored-types.mjs --quiet",
    "check:api-types-mirror": "node scripts/check-api-types-mirror.mjs --baseline",
    "check:api-types-mirror:baseline": "node scripts/check-api-types-mirror.mjs --write-baseline",
    "check:suppressions": "node scripts/check-suppressions.mjs",
    "check:function-baseline": "node scripts/check-function-baseline.mjs",
    "check:a11y-baseline": "node scripts/check-a11y-baseline.mjs",
    "check:a11y-baseline:write": "node scripts/check-a11y-baseline.mjs --write-baseline",
    "check:modules": "node scripts/check-module-settings.mjs",
    "check:modules:sync-backend": "node scripts/check-module-settings.mjs --sync-backend",
    "check:modules:catalog": "node scripts/check-module-catalog.mjs",
    "check:modules:catalog:sync-backend": "node scripts/check-module-catalog.mjs --sync-backend",
    "check:modules:contract": "node scripts/check-module-contract.mjs",
    "check:modules:contract:write": "node scripts/check-module-contract.mjs --write-snapshot",
    "check:dead": "knip",
    "check:dead:baseline": "node scripts/check-knip-baseline.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\"",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:console-baseline": "CONSOLE_BASELINE_WRITE=1 vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e:steps": "playwright test --project=chromium core-task-steps && playwright test --project=approvals --no-deps core-task-steps",
    "test:e2e:steps:write-baseline": "STEP_COUNTS_WRITE_BASELINE=1 playwright test --project=chromium --workers=1 --retries=0 core-task-steps && STEP_COUNTS_WRITE_BASELINE=1 playwright test --project=approvals --no-deps --workers=1 --retries=0 core-task-steps",
    "generate:api-types": "bash scripts/generate-api-types.sh",
    "generate:api-types:check": "bash scripts/generate-api-types.sh --check",
    "sync:emoji": "node scripts/sync-fluent-emoji.mjs --sync",
    "check:emoji": "node scripts/sync-fluent-emoji.mjs --check",
    "check:i18n:sync-backend": "node scripts/check-i18n-keys.mjs --sync-backend",
    "check:units-labels": "node scripts/check-units-labels.mjs --quiet"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-virtual": "^3.14.13",
    "axios": "^1.20.0",
    "browser-image-compression": "^2.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^3.0.6",
    "html5-qrcode": "^2.3.8",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.48.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^17.0.15",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "rehype-sanitize": "^6.0.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "web-vitals": "^6.2.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.4",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.5",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.11.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^27.4.0",
    "knip": "^5.0.0",
    "msw": "^2.15.0",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "tailwindcss": "^3.4.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    },
    "openapi-typescript": {
      "typescript": "npm:@typescript/typescript6@^6.0.2"
    }
  }
}
