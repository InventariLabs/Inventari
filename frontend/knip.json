{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/App.tsx",
    "src/test/**/*.{ts,tsx}",
    "tests/e2e/**/*.spec.ts",
    "src/**/*.test.{ts,tsx}", // vitest specs scattered inside src/
    "src/modules/*/module.ts", // registry entry points (side-effect registration)
    // A module's published surface (check-module-boundaries.mjs): its names are
    // a contract with the modules that import them, in this tree or outside
    // it, and a new module's file stays empty until a second module needs one.
    "src/modules/*/moduleApi.ts",
    // Public surface, not dead code: the design system and the module
    // registry are consumed ad-hoc by any module — treat as entry points so
    // their exports count as public API.
    "src/components/ui/*.tsx", // design-system public surface
    "src/lib/moduleRegistry.ts",
    "src/module-sdk.ts" // the surface a module may import — see the file's header
  ],
  "project": ["src/**/*.{ts,tsx}", "tests/e2e/**/*.ts"],
  // An interface describing a request or response shape is part of the API
  // client's surface even while its only current reader is the function
  // signature next to it. Stripping the export to satisfy the scan would
  // leave callers unable to name what they receive. Values are still
  // checked: an exported function or component nobody imports is dead.
  "ignoreExportsUsedInFile": { "interface": true, "type": true },
  "ignore": [
    "src/types/api-generated.ts" // generated by generate:api-types (checked in, not imported)
  ],
  "ignoreDependencies": [
    "openapi-typescript", // invoked via npx in scripts/generate-api-types.sh (knip can't see shell scripts)
    // The TS 7 compiler alias: `npx tsc` resolves to this package's binary
    // (frontend/AGENTS.md §4) — knip only sees imports, and nothing imports it.
    "@typescript/native"
  ],
  "rules": {
    "files": "error",
    "exports": "error",
    "types": "warn",
    "duplicates": "off"
  }
}
